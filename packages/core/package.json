{
  "name": "@ivkit/core",
  "version": "0.3.0",
  "description": "Headless engine for building interactive video experiences: questions, clickable hotspots, quizzes and branching, behind any interface you build. No dependencies.",
  "license": "Apache-2.0",
  "author": "Alexis Gonzalez",
  "homepage": "https://daniel-glz.github.io/ivkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel-Glz/ivkit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Daniel-Glz/ivkit/issues"
  },
  "keywords": [
    "interactive-video",
    "interactive",
    "video",
    "video-player",
    "branching-video",
    "branching",
    "hotspot",
    "hotspots",
    "quiz",
    "elearning",
    "headless",
    "framework-agnostic",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
