{
  "name": "@iv-player/player",
  "version": "0.0.0",
  "description": "<iv-player> Web Component for interactive videos, built on @iv-player/core",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/iv-player.min.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/server.js",
      "workerd": "./dist/server.js",
      "edge-light": "./dist/server.js",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "react-server": "./dist/server.js",
      "workerd": "./dist/server.js",
      "edge-light": "./dist/server.js",
      "import": "./dist/element.js"
    },
    "./iv-player.min.js": "./dist/iv-player.min.js"
  },
  "main": "./dist/index.js",
  "unpkg": "./dist/iv-player.min.js",
  "jsdelivr": "./dist/iv-player.min.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@iv-player/core": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "~20.14.6"
  }
}
