{
  "name": "@ivkit/player",
  "version": "0.1.1",
  "description": "Interactive video player Web Component: branching stories, questions and clickable animated hotspots. Under 8 KiB gzip, no third-party dependencies.",
  "license": "MIT",
  "author": "Alexis Gonzalez",
  "homepage": "https://daniel-glz.github.io/ivkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel-Glz/ivkit.git",
    "directory": "packages/player"
  },
  "bugs": {
    "url": "https://github.com/Daniel-Glz/ivkit/issues"
  },
  "keywords": [
    "interactive-video",
    "interactive",
    "video",
    "video-player",
    "branching-video",
    "branching",
    "hotspot",
    "hotspots",
    "quiz",
    "elearning",
    "web-component",
    "web-components",
    "custom-element",
    "react",
    "vue",
    "svelte",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/ivkit-player.min.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/server.js",
      "workerd": "./dist/server.js",
      "edge-light": "./dist/server.js",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "react-server": "./dist/server.js",
      "workerd": "./dist/server.js",
      "edge-light": "./dist/server.js",
      "import": "./dist/element.js"
    },
    "./ivkit-player.min.js": "./dist/ivkit-player.min.js"
  },
  "main": "./dist/index.js",
  "unpkg": "./dist/ivkit-player.min.js",
  "jsdelivr": "./dist/ivkit-player.min.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ivkit/core": "workspace:*"
  },
  "devDependencies": {
    "happy-dom": "~20.14.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
