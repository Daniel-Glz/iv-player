{
  "name": "@ivkit/react",
  "version": "0.2.0",
  "description": "React component for building interactive video experiences: questions, clickable hotspots, quizzes and branching, with typed props and event callbacks. Wraps <ivkit-player> for React 18 and 19.",
  "license": "Apache-2.0",
  "author": "Alexis Gonzalez",
  "homepage": "https://daniel-glz.github.io/ivkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daniel-Glz/ivkit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Daniel-Glz/ivkit/issues"
  },
  "keywords": [
    "interactive-video",
    "interactive",
    "video",
    "video-player",
    "branching-video",
    "branching",
    "hotspot",
    "hotspots",
    "quiz",
    "elearning",
    "react",
    "react-component",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ivkit/player": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "~20.14.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
